# Novel Studio の設定。`cp .env.example .env` してから必要なところだけ書き換える。
# （API キーは Settings 画面から保存することもできる。その場合ここは空でよい）

# OpenRouter の API キー（任意）。Settings で保存したキーがあればそちらを優先する
OPENROUTER_API_KEY=

# 画面から保存した API キーを暗号化する鍵（長いランダムな文字列を推奨）。
# 例: openssl rand -base64 32 の出力
# 空なら初回起動時に data/secret.key を自動で作る（その場合は data/ ごとバックアップすること）
APP_SECRET=

# ---- 以下は通常は変更不要 ----

# データ（SQLite・画像・暗号鍵）の置き場所。Docker では compose.yaml で /data に固定している
# DATA_DIR=./data

# Docker で使うとき、ホスト側で待ち受けるポート（127.0.0.1 のみ）
# NOVEL_PORT=3100

# パスで既存アプリと併存させる場合だけ設定する（例: /novel）。別ポートで動かすなら空のまま
# 変更したら作り直し（npm run build / docker compose up -d --build）が必要
# NEXT_PUBLIC_BASE_PATH=

# AI API の待ち時間の上限（ミリ秒）
# LLM_CONNECT_TIMEOUT_MS=90000   # 応答が始まるまで
# LLM_IDLE_TIMEOUT_MS=120000     # 本文の途中で何も届かない時間
# IMAGE_TIMEOUT_MS=180000        # 画像生成
