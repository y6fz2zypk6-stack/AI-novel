{
  "name": "novel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "LLMで小説を書く個人用PWA",
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3100}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
